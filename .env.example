# Copy to .env (gitignored) in the main checkout and fill in. Linked worktrees read the main checkout's .env.
# Check it with scripts/whoami.py.

# Who you are: your profile is players/<MTG_PLAYER>.md
MTG_PLAYER=yourname

ARCHIDEKT_USERNAME=your-archidekt-username
# Numeric; only the collection endpoint needs it. It's in your Archidekt collection URL.
ARCHIDEKT_USER_ID=
ARCHIDEKT_PASSWORD=
# Optional: 1Password item id to read the password from when ARCHIDEKT_PASSWORD is empty.
ARCHIDEKT_OP_ITEM=

# Archidekt folder ids (the number in a folder's URL). Uploads and pulls default to the decks folder.
ARCHIDEKT_DECKS_FOLDER=
ARCHIDEKT_IDEAS_FOLDER=
ARCHIDEKT_ARCHIVE_FOLDER=

# Optional, for reading your Moxfield decks and a collection shared by link.
MOXFIELD_USERNAME=
MOXFIELD_COLLECTION_ID=
